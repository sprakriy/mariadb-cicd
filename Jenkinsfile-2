pipeline {
  //agent any // Run directly on the host agent
  agent {
    docker { image 'liquibase/liquibase:4.20.0' 
    // CRUCIAL: Links the container network directly to your laptop host
    args '--network=host -e INSTALL_MYSQL=true --entrypoint=""'
    }
  }
  stages {
    stage('Liquibase Operations') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'mariadb-credentials', 
                                          usernameVariable: 'MARIADB_CREDS_USR', 
                                          passwordVariable: 'MARIADB_CREDS_PSW')]) {
          
          echo 'Dropping all existing tables to start clean...'
          sh 'liquibase drop-all --driver=org.mariadb.jdbc.Driver --url="jdbc:mariadb://127.0.0.1:3306/liquibase_db" --username=$MARIADB_CREDS_USR --password=$MARIADB_CREDS_PSW'
          
          echo 'Checking Database Status...'
          sh 'liquibase status --driver=org.mariadb.jdbc.Driver --url="jdbc:mariadb://127.0.0.1:3306/liquibase_db" --changeLogFile=my_app-wrapper.xml --username=$MARIADB_CREDS_USR --password=$MARIADB_CREDS_PSW'
          
          echo 'Running Database Update...'
          sh 'liquibase update --driver=org.mariadb.jdbc.Driver --url="jdbc:mariadb://127.0.0.1:3306/liquibase_db" --changeLogFile=my_app-wrapper.xml --username=$MARIADB_CREDS_USR --password=$MARIADB_CREDS_PSW'
        }
      }
    }
  }
  post {
    always {
      // Fixes the hudson.FilePath context issue
      node('') {
        cleanWs()
      }
    }
  }
}
